# Copy to .env and fill in your PUBG developer API key.
# The key is only read by the crawler process; never expose it to the web app.
PUBG_API_KEY=
PUBG_DEFAULT_SHARD=steam
PUBG_RATE_LIMIT_RPM=10
PUBG_MATCH_LIMIT=32
PUBG_MATCH_CONCURRENCY=5
PUBG_TELEMETRY_CONCURRENCY=2
PUBG_TELEMETRY_TIMEOUT_MS=60000
PUBG_DB_PATH=data/pubg.db

# API: how many stored match details the profile returns (season stats stay full)
PROFILE_RECENT_MATCH_LIMIT=20
# API: minimum seconds between refresh attempts for the same account
REFRESH_COOLDOWN_SECONDS=60
SEASON_SCAN_LIMIT=10
SEASON_SCAN_BATCH_SIZE=2
SEASON_SCAN_INTERVAL_SECONDS=60

PORT=3001
CRAWLER_AUTOSTART=true
